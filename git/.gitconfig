[user]
  name = Josh Bebbington
  email = bebbs@users.noreply.github.com

[init]
  defaultBranch = main

[core]
  excludesFile = ~/.gitignore_global

[alias]
  br = branch
  cb = checkout -b
  co = checkout
  dfl = "!git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || { git remote set-head origin --auto >/dev/null && git symbolic-ref --short refs/remotes/origin/HEAD; }"
  com = "!b=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || git dfl) && git switch \"${b#origin/}\""
  pom = "!b=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || git dfl) && git switch \"${b#origin/}\" && git pull --ff-only"
  p = push
  search = log --c -S
  st = status

[rerere]
  enabled = true

[branch]
  sort = -committerdate

# Keep refs/remotes/origin/HEAD in sync on fetch. The default, "create", only
# writes it when absent, so a repo that later changes its default branch would
# keep a stale value forever.
[remote "origin"]
  followRemoteHEAD = always

# Auth is delegated to the gh CLI, scoped to GitHub hosts only. `gh` comes from
# PATH so this resolves on both Apple Silicon and Intel.
#
# Never add a host-less [credential] helper that echoes $GITHUB_TOKEN: it sends
# the PAT to every host git talks to, leaking it to any typo'd or hostile URL.
[credential "https://github.com"]
  helper =
  helper = !gh auth git-credential

[credential "https://gist.github.com"]
  helper =
  helper = !gh auth git-credential
