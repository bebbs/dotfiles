[user]
  name = Josh Bebbington
  email = bebbs@users.noreply.github.com

[init]
	defaultBranch = main

[alias]
  br = branch
  cb = checkout -b
  co = checkout
  com = checkout master
  pom = pull origin master
  p = push
  search = log --c -S
  st = status
[rerere]
	enabled = true
[branch]
	sort = -committerdate
[core]
  excludesFile = ~/.gitignore
