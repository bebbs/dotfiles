# carwow-only packages. Installed by bin/homebrew when ~/.dotfiles-profile
# says "work".

# Non-official taps also need trusting before Homebrew will load from them:
#   brew trust --cask siddharthvaddem/openscreen/openscreen
tap "siddharthvaddem/openscreen"

# --- Cloud and infrastructure ---
brew "awscli"
brew "heroku"
brew "terraformer"

# Must precede google-cloud-sdk: the cask's post-install runs `gcloud config
# virtualenv create`, which aborts the install if virtualenv is not on PATH.
brew "virtualenv"
cask "google-cloud-sdk"

# --- CI and deploys ---
brew "circleci"

# --- Data ---
brew "sqlfluff"          # sql linter

# --- Languages the monolith and its tooling need ---
brew "poetry"
brew "yarn"

# --- Media processing (image/video pipelines) ---
brew "ffmpeg"
brew "imagemagick"
brew "libvorbis"

# --- Misc ---
brew "docutils"
brew "gowsdl"            # soap client generator

# --- Applications ---
cask "orbstack"          # docker/linux VMs
cask "ngrok"             # tunnels for webhook testing
cask "openscreen"
