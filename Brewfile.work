# carwow-only packages. Installed by bin/homebrew when ~/.dotfiles-profile
# says "work".

# Non-official taps also need trusting before Homebrew will load from them:
#   brew trust --cask siddharthvaddem/openscreen/openscreen
tap "siddharthvaddem/openscreen"

# --- Cloud and infrastructure ---
brew "awscli"
brew "heroku"
brew "terraformer"

# The gcloud-cli cask is not listed: its post-install builds a virtualenv with
# python@3.14, whose pyexpat cannot resolve _XML_SetAllocTrackerActivationThreshold
# against the macOS 26 system libexpat, so the install always rolls back.
# Install the SDK to $HOMEBREW_PREFIX/share/google-cloud-sdk by hand until the
# bottle is fixed; carwow/.zshrc.work picks it up from there.

# --- CI and deploys ---
brew "circleci"

# --- Data ---
brew "sqlfluff"          # sql linter

# --- Languages the monolith and its tooling need ---
brew "poetry"
brew "yarn"

# --- Media processing (image/video pipelines) ---
brew "ffmpeg"
brew "imagemagick"
brew "libvorbis"

# --- Misc ---
brew "docutils"
brew "gowsdl"            # soap client generator

# --- Applications ---
cask "orbstack"          # docker/linux VMs
cask "ngrok"             # tunnels for webhook testing
cask "openscreen"
