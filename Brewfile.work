# carwow-only packages. Installed by bin/homebrew when ~/.dotfiles-profile
# says "work".

# Everything here comes from an official tap. A cask from a third-party tap
# needs `brew trust` before Homebrew will load it, and an untrusted one aborts
# the whole bundle rather than just its own entry.

# awscli, circleci, yarn and the heroku CLI are managed by mise, not here — see
# carwow/.config/mise/conf.d/work.toml.

# --- Data ---
brew "sqlfluff"          # sql linter; no mise registry entry

# --- Media processing (image/video pipelines) ---
brew "ffmpeg"
brew "imagemagick"
brew "libvorbis"

# --- Misc ---
brew "docutils"
brew "gowsdl"            # soap client generator

# --- Applications ---
cask "orbstack"          # docker/linux VMs
