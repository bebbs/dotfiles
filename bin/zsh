#!/usr/bin/env bash
#
# oh-my-zsh, its plugins, and zsh as the login shell.

set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bin/lib/common.sh
source "$BIN_DIR/lib/common.sh"

ZSH_DIR="$HOME/.oh-my-zsh"
ZSH_CUSTOM="${ZSH_CUSTOM:-$ZSH_DIR/custom}"

PLUGINS="zsh-users/zsh-syntax-highlighting zsh-users/zsh-autosuggestions"

heading "oh-my-zsh"
if [ -d "$ZSH_DIR" ]; then
  skip "already installed"
else
  # --unattended stops the installer from rewriting .zshrc or exec'ing a shell,
  # both of which would fight with stow.
  RUNZSH=no KEEP_ZSHRC=yes \
    sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
  success "installed"
fi

heading "zsh plugins"
for repo in $PLUGINS; do
  name="${repo##*/}"
  dest="$ZSH_CUSTOM/plugins/$name"
  if [ -d "$dest/.git" ]; then
    git -C "$dest" pull --quiet --ff-only && success "$name updated"
  elif [ -e "$dest" ]; then
    warn "$dest exists but is not a git checkout — leaving it alone"
  else
    git clone --quiet --depth 1 "https://github.com/$repo.git" "$dest"
    success "$name installed"
  fi
done

heading "Login shell"
zsh_path="$(command -v zsh)"
if [ "${SHELL:-}" = "$zsh_path" ]; then
  skip "already zsh ($zsh_path)"
else
  # /etc/shells has to list the shell before chsh will accept it. Homebrew zsh
  # is not there by default; the system one always is.
  if ! grep -qxF "$zsh_path" /etc/shells; then
    info "Adding $zsh_path to /etc/shells (needs sudo)"
    printf '%s\n' "$zsh_path" | sudo tee -a /etc/shells >/dev/null
  fi
  # No sudo needed to change your own shell — it will prompt for your password.
  chsh -s "$zsh_path"
  success "login shell set to $zsh_path"
fi
