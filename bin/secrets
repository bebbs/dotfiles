#!/usr/bin/env bash
#
# Interactive wizard for the tokens that cannot live in git.
#
# Reads secrets.manifest, tells you where to get each token, takes it on stdin
# without echoing, and writes zsh/.secrets (mode 600, gitignored). Re-running is
# safe: anything already set is left alone unless you ask for it.
#
#   bin/secrets              fill in whatever is missing
#   bin/secrets --check      report what is set, prompt for nothing
#   bin/secrets --all        re-prompt everything (rotation)
#   bin/secrets NAME [NAME]  re-prompt just these

set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bin/lib/common.sh
source "$BIN_DIR/lib/common.sh"

MANIFEST="$DOTFILES_ROOT/secrets.manifest"
SECRETS_FILE="$DOTFILES_ROOT/zsh/.secrets"
US=$'\x1f' # record separator for packing help lines into one string

# --- manifest parsing ------------------------------------------------------
# bash 3.2 has no associative arrays, so records live in parallel arrays.

M_NAME=() M_SCOPE=() M_LABEL=() M_URL=() M_PATTERN=() M_HELP=()

parse_manifest() {
  [ -f "$MANIFEST" ] || die "manifest not found: $MANIFEST"

  local name='' scope='' label='' url='' pattern='' help='' line key value

  flush() {
    [ -z "$name" ] && return 0
    M_NAME+=("$name")
    M_SCOPE+=("${scope:-core}")
    M_LABEL+=("${label:-$name}")
    M_URL+=("$url")
    M_PATTERN+=("$pattern")
    M_HELP+=("$help")
    name='' scope='' label='' url='' pattern='' help=''
  }

  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      '#'*|'') continue ;;
      '---'*)  flush; continue ;;
    esac

    key="${line%%:*}"
    value="${line#*:}"
    # strip one leading space from the value
    value="${value# }"

    case "$key" in
      name)    name="$value" ;;
      scope)   scope="$value" ;;
      label)   label="$value" ;;
      url)     url="$value" ;;
      pattern) pattern="$value" ;;
      help)    if [ -z "$help" ]; then help="$value"; else help="$help$US$value"; fi ;;
      *)       warn "ignoring unknown manifest key '$key'" ;;
    esac
  done < "$MANIFEST"

  flush
}

# --- reading the current secrets file --------------------------------------

# value_of NAME -> prints the current value, empty if unset.
#
# The file is sourced in a subshell rather than pattern-matched, so that the
# shell does the unquoting. Reading `export X='a'\''b'` textually and then
# re-quoting it on write would double-escape the value a little more on every
# run; letting the shell parse it makes the read/write cycle lossless.
value_of() {
  [ -f "$SECRETS_FILE" ] || return 0
  (
    set +u
    # shellcheck disable=SC1090
    . "$SECRETS_FILE" >/dev/null 2>&1 || true
    eval "printf '%s' \"\${$1-}\""
  )
}

# Any `export FOO=...` in the file that the manifest does not know about, so a
# hand-added variable is never silently dropped when we rewrite.
unmanaged_lines() {
  [ -f "$SECRETS_FILE" ] || return 0
  local line name i known
  while IFS= read -r line; do
    case "$line" in
      export*) ;;
      *) continue ;;
    esac
    name="${line#export }"
    name="${name%%=*}"
    known=0
    i=0
    while [ $i -lt ${#M_NAME[@]} ]; do
      [ "${M_NAME[$i]}" = "$name" ] && known=1 && break
      i=$((i + 1))
    done
    [ $known -eq 0 ] && printf '%s\n' "$line"
  done < "$SECRETS_FILE"
}

# --- prompting -------------------------------------------------------------

# prompt_for INDEX -> prints the entered value on stdout, empty if skipped.
# Everything the human reads goes to stderr, so that the caller can capture
# the value with $(...) without swallowing the instructions.
prompt_for() {
  local i="$1"
  local name="${M_NAME[$i]}" label="${M_LABEL[$i]}"
  local url="${M_URL[$i]}" pattern="${M_PATTERN[$i]}" help="${M_HELP[$i]}"
  local value line

  {
    printf '\n  %s%s%s\n' "$C_BOLD" "$name" "$C_RESET"
    printf '    %s\n' "$label"
    [ -n "$url" ] && printf '    %sgo to:%s %s\n' "$C_DIM" "$C_RESET" "$url"

    if [ -n "$help" ]; then
      printf '\n'
      printf '%s\n' "$help" | tr "$US" '\n' | while IFS= read -r line; do
        printf '      %s%s%s\n' "$C_DIM" "$line" "$C_RESET"
      done
    fi
  } >&2

  while :; do
    printf '\n    paste value (or press enter to skip): ' >&2
    read -rs value || value=''
    printf '\n' >&2

    if [ -z "$value" ]; then
      skip "$name skipped" >&2
      return 0
    fi

    if [ -n "$pattern" ] && ! [[ $value =~ $pattern ]]; then
      warn "that does not look like a $name (expected /$pattern/)"
      if confirm "Use it anyway?" n; then
        printf '%s' "$value"
        return 0
      fi
      continue
    fi

    printf '%s' "$value"
    return 0
  done
}

# --- writing ---------------------------------------------------------------

write_secrets() {
  local tmp i name value
  tmp="$(mktemp "${TMPDIR:-/tmp}/dotfiles-secrets.XXXXXX")"
  chmod 600 "$tmp"

  {
    echo "# Generated by bin/secrets — do not commit (this file is gitignored)."
    echo "# Add or change a secret by editing secrets.manifest, then re-running"
    echo "# bin/secrets. To rotate everything: bin/secrets --all"
    echo
    i=0
    while [ $i -lt ${#M_NAME[@]} ]; do
      name="${M_NAME[$i]}"
      eval "value=\${NEW_$name-}"
      if [ -n "$value" ]; then
        printf 'export %s=%s\n' "$name" "$(quote "$value")"
      fi
      i=$((i + 1))
    done

    local extras
    extras="$(unmanaged_lines || true)"
    if [ -n "$extras" ]; then
      echo
      echo "# Not in secrets.manifest — preserved as-is."
      printf '%s\n' "$extras"
    fi
  } > "$tmp"

  mv "$tmp" "$SECRETS_FILE"
  chmod 600 "$SECRETS_FILE"
}

# single-quote a value for safe shell inclusion
quote() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# --- main ------------------------------------------------------------------

usage() {
  cat <<'EOF'
Usage: bin/secrets [options] [NAME...]

Interactive wizard for the tokens that cannot live in git. Tells you where to
get each one, takes it without echoing, and writes zsh/.secrets (mode 600).

  (no args)      fill in whatever is missing
  --check        report what is set, prompt for nothing
  --all          re-prompt everything (rotation)
  NAME [NAME]    re-prompt just these

The list of secrets lives in secrets.manifest, not in this script.
EOF
}

mode="missing"
requested=()

while [ $# -gt 0 ]; do
  case "$1" in
    --check) mode="check" ;;
    --all|--force) mode="all" ;;
    -h|--help) usage; exit 0 ;;
    -*) die "unknown option: $1" ;;
    *) requested+=("$1"); mode="named" ;;
  esac
  shift
done

parse_manifest
[ ${#M_NAME[@]} -gt 0 ] || die "no records found in $MANIFEST"

profile="$(dotfiles_profile)"
[ -z "$profile" ] && profile="$(ensure_profile)"

# Validate any explicitly named secrets up front.
for want in ${requested[@]+"${requested[@]}"}; do
  found=0
  i=0
  while [ $i -lt ${#M_NAME[@]} ]; do
    [ "${M_NAME[$i]}" = "$want" ] && found=1 && break
    i=$((i + 1))
  done
  [ $found -eq 1 ] || die "$want is not in secrets.manifest"
done

if [ "$mode" = "check" ]; then
  heading "Secrets ($profile machine)"
  i=0
  while [ $i -lt ${#M_NAME[@]} ]; do
    name="${M_NAME[$i]}"
    if [ "${M_SCOPE[$i]}" = "carwow" ] && [ "$profile" != "work" ]; then
      skip "$name (carwow only, not needed here)"
    elif [ -n "$(value_of "$name")" ]; then
      success "$name is set"
    else
      warn "$name is MISSING — run: bin/secrets $name"
    fi
    i=$((i + 1))
  done
  exit 0
fi

heading "Secrets ($profile machine)"
info "Values are hidden as you type and written to zsh/.secrets (mode 600),"
info "which is gitignored. Press enter at any prompt to skip it."

changed=0
i=0
while [ $i -lt ${#M_NAME[@]} ]; do
  name="${M_NAME[$i]}"
  current="$(value_of "$name")"

  # Always carry the existing value forward; only overwrite on a fresh entry.
  eval "NEW_$name=\$current"

  ask=0
  case "$mode" in
    all) ask=1 ;;
    named)
      for want in ${requested[@]+"${requested[@]}"}; do
        [ "$want" = "$name" ] && ask=1
      done
      ;;
    missing) [ -z "$current" ] && ask=1 ;;
  esac

  # Never prompt for work secrets on a personal machine.
  if [ "${M_SCOPE[$i]}" = "carwow" ] && [ "$profile" != "work" ]; then
    ask=0
  fi

  if [ $ask -eq 1 ]; then
    if [ -n "$current" ] && [ "$mode" != "named" ]; then
      info ""
      skip "$name is already set — rotating"
    fi
    entered="$(prompt_for "$i")"
    if [ -n "$entered" ]; then
      eval "NEW_$name=\$entered"
      success "$name captured"
      changed=1
    fi
  elif [ -n "$current" ]; then
    skip "$name already set"
  fi

  i=$((i + 1))
done

write_secrets

heading "Done"
if [ $changed -eq 1 ]; then
  success "wrote $SECRETS_FILE"
else
  skip "no changes — $SECRETS_FILE rewritten in manifest order"
fi
info "Reload your shell to pick them up:  exec zsh"
info "Check status any time with:         bin/secrets --check"
