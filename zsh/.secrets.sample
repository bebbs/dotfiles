# Example of the file bin/secrets generates as zsh/.secrets (mode 600,
# gitignored, symlinked to ~/.secrets and sourced by .zshrc).
#
# Do not fill this in by hand and do not copy it into place — run:
#
#   bin/secrets            fill in anything missing
#   bin/secrets --check    see what is set
#   bin/secrets --all      rotate everything
#
# The authoritative list of secrets, including where to get each one, is
# ../secrets.manifest. This file is only here to show the shape of the output.

export GITHUB_TOKEN='ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'
export GITHUB_PACKAGES_TOKEN='ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'
export HONEYCOMB_CLAUDE_TELEMETRY_KEY='xxxxxxxxxxxxxxxxxxxxxx'
export HONEYCOMB_TOKEN='xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'
export BUGSNAG_AUTH_TOKEN='00000000-0000-0000-0000-000000000000'
